# Copy this file to %LOCALAPPDATA%\ScheduleMatcher\.env (NOT into OneDrive!)
# and fill in your values.

TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your own Telegram user id. Only this account can run /dev and grant
# developer mode to others. Kept here (outside the repo) so no id is
# ever committed to git. Message @userinfobot on Telegram to find yours.
OWNER_ID=

# Optional overrides
# SCHEDULE_MATCHER_HOME=C:\somewhere\local
# LIBCAL_BASE=https://libcalendar.ntu.edu.sg
# HEADFUL=1                # show the booking browser window (debugging)
# MAX_BOOKING_MINUTES=240
# BOOKING_DAYS_AHEAD=7
# EMAIL_POLL_MINUTES=10
# HOLD_MAX_MINUTES=60      # how long a chope keeps renewing; 0 = forever
# MAX_HOLDS=6              # how many spaces can be choped at once
#                         # each is a headless browser, ~270 MB:
#                         # use 2 on a 4 GB machine, 4 on 8 GB
# MIN_FREE_RAM_MB=500     # refuse a new hold below this much free RAM
# MAX_DEBUG_FILES=40      # diagnostics kept in debug/
